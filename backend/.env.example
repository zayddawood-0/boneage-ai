# Copy to backend/.env and fill in real values. Never commit the real .env (see root .gitignore).

# SQLite for local dev/tests (path relative to where you run uvicorn from).
# In production this is a Postgres connection string (Neon, via the Vercel
# Marketplace) — Vercel sets it automatically when you connect the Neon
# integration to the project; see README.md#deployment-setup-vercel--github-actions.
# A bare postgres://... or postgresql://... URL is normalised to use the
# psycopg driver automatically (see app/database.py) — no need to edit it.
DATABASE_URL=sqlite:///./backend/boneage.db

# JWT signing key — generate a real random secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local storage for uploaded X-rays and generated heatmaps (gitignored) — used
# whenever Blob isn't configured (below). See app/storage.py.
UPLOAD_DIR=backend/uploads

# Vercel Blob. Leave both unset for local dev (storage falls back to local
# disk automatically — see app/storage.py). In production, connecting a
# Blob store to the project (`vercel storage connect`) sets BLOB_STORE_ID
# automatically (OIDC credentials, no static token involved) — either var's
# mere presence is what switches storage.py to Blob.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Where the exported ONNX graphs + metadata.json live (see
# ml/boneage/onnx_export.py, ml/export_onnx.py). Gitignored, like the old
# .pt checkpoint. If missing, the API lazily tries ONNX_DOWNLOAD_URL on the
# first real prediction request, then falls back to the clearly-labelled
# mock predictor if that's unset or fails too — see app/inference_adapter.py.
# Leave unset in production: on Vercel (VERCEL=1, set automatically) this
# defaults to /tmp/boneage-onnx instead of this repo-relative path, since
# the deployed function's own filesystem is read-only and only /tmp is
# writable — see app/config.py. /tmp persists across invocations on the
# same warm instance, so a warm function reuses the downloaded model
# instead of re-fetching it every request.
ML_ONNX_DIR=ml/checkpoints/onnx
ONNX_DOWNLOAD_URL=

# Growth review agent note-writing (OpenAI Agents SDK). If unset, the agent falls back to a
# fixed template note instead of calling an LLM — see AGENTS.md#the-growth-review-agent.
OPENAI_API_KEY=

# SD-based reference table (empty [TBD] template by default — see backend/data/reference_tables).
REFERENCE_TABLE_PATH=backend/data/reference_tables/greulich_pyle_sd_reference.json

# Allowed frontend origin(s) for CORS, comma-separated. Local dev talks to the
# backend through the Vite proxy (vite.config.ts) so this isn't needed there;
# set it to the Vercel frontend project's URL in production.
CORS_ORIGIN=http://localhost:5173

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls GET /internal/retention-cleanup (see vercel.json's `crons` and
# app/routers/internal.py). Leave unset locally — the endpoint always 401s
# without it, which is fine since nothing calls it outside of Vercel Cron.
CRON_SECRET=
