# Copy to backend/.env and fill in real values. Never commit the real .env (see root .gitignore).

# SQLite for the hackathon (see docs/architecture.md). Path is relative to where you run uvicorn from.
DATABASE_URL=sqlite:///./backend/boneage.db

# JWT signing key — generate a real random secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local storage for uploaded X-rays and generated heatmaps (gitignored).
UPLOAD_DIR=backend/uploads

# Real model checkpoint + its training config (see ml/README.md). If the checkpoint file
# doesn't exist, the API falls back to a clearly-labelled mock predictor automatically.
ML_CHECKPOINT_PATH=ml/checkpoints/best_model.pt
ML_CONFIG_PATH=ml/config/config.yaml

# Growth review agent note-writing (OpenAI Agents SDK). If unset, the agent falls back to a
# fixed template note instead of calling an LLM — see AGENTS.md#the-growth-review-agent.
OPENAI_API_KEY=

# SD-based reference table (empty [TBD] template by default — see backend/data/reference_tables).
REFERENCE_TABLE_PATH=backend/data/reference_tables/greulich_pyle_sd_reference.json

# Allowed frontend origin(s) for CORS, comma-separated. Local dev talks to the
# backend through the Vite proxy (vite.config.ts) so this isn't needed there;
# set it to the Vercel URL in production (see render.yaml).
CORS_ORIGIN=http://localhost:5173

# Optional: URL to download the trained model checkpoint from at backend
# startup (e.g. a release asset or object storage URL) — see
# backend/scripts/download_checkpoint.py. The checkpoint is gitignored, so a
# host with an ephemeral filesystem (Render's free tier) needs this on every
# deploy. If unset, or the download fails, the API falls back to the
# clearly-labelled mock predictor automatically.
CHECKPOINT_DOWNLOAD_URL=
